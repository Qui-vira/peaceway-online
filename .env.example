# ─── Telegram ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Public HTTPS base URL for webhooks (Railway gives you one). Leave blank for local polling.
WEBHOOK_BASE_URL=

# ─── Database (Peaceway's own) ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/peaceway

# ─── PharmaOS import source (read-only, import script only) ──────────────────
PHARMAOS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pharmaos

# ─── Pharmacy identity ───────────────────────────────────────────────────────
PHARMACY_NAME=Peaceway Pharmacy

# ─── Manual bank transfer details (shown to customers) ───────────────────────
# Single account (legacy / fallback):
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_NAME=
# Multiple accounts (preferred): "Bank|Account Name|Number" separated by ";"
# e.g. OPay|PEACEWAY HEALTH CARE LTD 2|6542539524;Access Bank|Peaceway Health Care|0036802946
BANK_ACCOUNTS=

# ─── Flutterwave ─────────────────────────────────────────────────────────────
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# ─── Staff role IDs (comma-separated numeric Telegram user IDs) ──────────────
OWNER_TELEGRAM_IDS=
PHARMACIST_TELEGRAM_IDS=
PACKAGING_STAFF_TELEGRAM_IDS=
DISPATCHER_TELEGRAM_IDS=
SUPPORT_TELEGRAM_IDS=

# ─── Staff role emails (comma-separated) ─────────────────────────────────────
OWNER_EMAILS=
PHARMACIST_EMAILS=
PACKAGING_STAFF_EMAILS=
DISPATCHER_EMAILS=
SUPPORT_EMAILS=

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ─── Resend (email OTP) ──────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@peacewayonline.com

# ─── Optional private staff group for alerts (leave blank for launch) ────────
STAFF_GROUP_CHAT_ID=

# ─── Logistics provider API keys (P2 — leave blank, providers stay disabled) ─
KWIK_API_KEY=
FEZ_API_KEY=
GOKADA_API_KEY=
CUSTOM_API_KEY=

# ─── Crypto off-ramp (P3 — optional; leave blank to keep crypto disabled) ────
# Format: NETWORK:TOKEN:ADDRESS, comma-separated. e.g. TRON:USDT:Txxxx,BSC:USDT:0xabc
CRYPTO_WALLETS=

# ─── Web API (Phase 0+) ──────────────────────────────────────────────────────
# Comma-separated origins allowed to call /api/v1/* from a browser.
# Production: https://peacewayonline.com
# Local dev:  http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Random 32-char secret for signing web session tokens (Phase 1+).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEB_SECRET=

# Medication reminders dispatcher (60s interval job). Ships OFF; set true to
# enable after the customer bot flows are live.
REMINDERS_ENABLED=false

# ─── Runtime ─────────────────────────────────────────────────────────────────
ENV=development
LOG_LEVEL=INFO

# Firecrawl API key — used by scripts/crawl_manufacturer.py only. Never needed by the app.
FIRECRAWL_API_KEY=
