# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Secrets
.env
.env.*
!.env.example

# Frontend build/install artifacts
web/node_modules/
web/.next/
web/.vercel/
web/*.tsbuildinfo

# Local agent / tooling scratch (not part of the app)
.claude/
.playwright-mcp/
.agents/
.codex/
skills-lock.json

# Generated knowledge graph (rebuilt with `graphify update .`)
/graphify-out/

# Stray root-level npm install. The app lives in web/ and resolves its own
# deps from web/node_modules; nothing at the repo root is an npm package.
/node_modules/

# Import exports (may contain catalog data)
scripts/exports/

# OS / editor
.DS_Store
Thumbs.db

.vercel
.env*.local

# Generated screenshots from scripts/video/*.mjs
scripts/video/out/

# Local design-tooling state. The one artefact worth keeping — the web-app
# critique — lives in tasks/ instead.
.impeccable/

# Slide decks: the build scripts and their manifest are the source and are
# tracked. Dependencies and every rendered artefact are not. Matched by
# extension so future renders are caught without editing this file.
presentations/node_modules/
presentations/*.pdf
presentations/*.pptx
presentations/*.jpg
presentations/*.png
presentations/qa-slides/
